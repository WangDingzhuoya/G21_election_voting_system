# Database address used by server.js.
# The server reads it from the process environment, so export it in your shell
# before running "npm start" (see README.md for the three ways to do this).
#
# A local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/emvs
#
# A MongoDB Atlas cluster (the address starts with mongodb+srv://):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/emvs
